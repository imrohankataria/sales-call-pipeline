# Copy to .env or run: python scripts/check_setup.py --init
# Fill only fields for the selected setup. Never put real values in this file.
# .env is private and ignored. Values are literal KEY=value, optionally quoted.

# AWS uses CLI browser login/SSO and temporary credentials, not access keys here.
# Match aws_profile and aws_region in config.local.json after verifying the project.
AWS_PROFILE=
AWS_REGION=

# Optional Slack app preparation. Slack ingress is not implemented in this starter.
# Bot token: OAuth & Permissions after installation in the selected workspace.
SLACK_BOT_TOKEN=
# HTTP request verification: Basic Information > App Credentials.
SLACK_SIGNING_SECRET=
# Socket Mode only: app-level token with connections:write.
SLACK_APP_TOKEN=
# Distributed OAuth installation only; unused by the current starter.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional API-based coding harness; normal Claude/Codex login needs neither key.
# These keys do not authenticate the starter's Bedrock model calls.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
