{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sales Call Pipeline gtm: dedicated single-Region deployment",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "LogsKeyArn": {
      "Type": "String"
    },
    "CodeKey": {
      "Type": "String"
    },
    "CrmTable": {
      "Type": "String"
    },
    "RuntimeArn": {
      "Type": "String"
    },
    "PipelineName": {
      "Type": "String",
      "AllowedPattern": "[a-z][a-z0-9-]{2,35}"
    },
    "RuntimeName": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9_]{2,47}"
    }
  },
  "Resources": {
    "SlackSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "${PipelineName}-slack"
        },
        "Description": "Dedicated demo Slack bot, request verification and user skill grants",
        "SecretString": "{\"team_id\": \"\", \"allowed_users\": [], \"skill_grants\": {}, \"bot_token\": \"\", \"signing_secret\": \"\"}"
      }
    },
    "AuthSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Name": {
          "Fn::Sub": "${PipelineName}-execution-grants"
        },
        "Description": "Short-lived application scope signatures; separate from Slack token",
        "GenerateSecretString": {
          "SecretStringTemplate": "{}",
          "GenerateStringKey": "secret",
          "PasswordLength": 48,
          "ExcludePunctuation": true
        }
      }
    },
    "JobsTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "request_id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "request_id",
            "KeyType": "HASH"
          }
        ],
        "SSESpecification": {
          "SSEEnabled": true
        },
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        }
      }
    },
    "DeadLetterQueue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "MessageRetentionPeriod": 604800,
        "SqsManagedSseEnabled": true
      }
    },
    "Queue": {
      "Type": "AWS::SQS::Queue",
      "Properties": {
        "VisibilityTimeout": 720,
        "MessageRetentionPeriod": 86400,
        "SqsManagedSseEnabled": true,
        "RedrivePolicy": {
          "deadLetterTargetArn": {
            "Fn::GetAtt": [
              "DeadLetterQueue",
              "Arn"
            ]
          },
          "maxReceiveCount": 3
        }
      }
    },
    "ToolsLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-tools"
        },
        "RetentionInDays": 7,
        "KmsKeyId": {
          "Ref": "LogsKeyArn"
        }
      }
    },
    "IngressLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-ingress"
        },
        "RetentionInDays": 7,
        "KmsKeyId": {
          "Ref": "LogsKeyArn"
        }
      }
    },
    "WorkerLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-worker"
        },
        "RetentionInDays": 7,
        "KmsKeyId": {
          "Ref": "LogsKeyArn"
        }
      }
    },
    "BackendLogs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/lambda/${AWS::StackName}-backend"
        },
        "RetentionInDays": 7,
        "KmsKeyId": {
          "Ref": "LogsKeyArn"
        }
      }
    },
    "ToolsRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedDemo",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-tools:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${CrmTable}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "AuthSecret"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "ToolsFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-tools"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "gateway_tools.handler",
        "Role": {
          "Fn::GetAtt": [
            "ToolsRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 15,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "CRM_TABLE": {
              "Ref": "CrmTable"
            },
            "AUTH_SECRET_ARN": {
              "Ref": "AuthSecret"
            }
          }
        }
      },
      "DependsOn": "ToolsLogs"
    },
    "GatewayRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OnlySyntheticTools",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "lambda:InvokeFunction"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "ToolsFunction",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Gateway": {
      "Type": "AWS::BedrockAgentCore::Gateway",
      "Properties": {
        "Name": {
          "Ref": "PipelineName"
        },
        "Description": "Scoped synthetic GTM tools",
        "AuthorizerType": "AWS_IAM",
        "ProtocolType": "MCP",
        "RoleArn": {
          "Fn::GetAtt": [
            "GatewayRole",
            "Arn"
          ]
        },
        "Tags": {
          "Purpose": "SalesCallPipeline",
          "Data": "Synthetic"
        }
      }
    },
    "Target": {
      "Type": "AWS::BedrockAgentCore::GatewayTarget",
      "Properties": {
        "GatewayIdentifier": {
          "Fn::GetAtt": [
            "Gateway",
            "GatewayIdentifier"
          ]
        },
        "Name": "crm-tools",
        "CredentialProviderConfigurations": [
          {
            "CredentialProviderType": "GATEWAY_IAM_ROLE"
          }
        ],
        "TargetConfiguration": {
          "Mcp": {
            "Lambda": {
              "LambdaArn": {
                "Fn::GetAtt": [
                  "ToolsFunction",
                  "Arn"
                ]
              },
              "ToolSchema": {
                "InlinePayload": [
                  {
                    "Name": "filter_findings",
                    "Description": "Apply a fixed evidence-confidence gate to bounded synthetic proposals.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "findings": {
                          "Type": "array",
                          "Items": {
                            "Type": "object"
                          }
                        },
                        "threshold": {
                          "Type": "number"
                        },
                        "authorization": {
                          "Type": "object",
                          "Properties": {
                            "grant": {
                              "Type": "object"
                            },
                            "signature": {
                              "Type": "string"
                            }
                          },
                          "Required": [
                            "grant",
                            "signature"
                          ]
                        }
                      },
                      "Required": [
                        "findings",
                        "threshold",
                        "authorization"
                      ]
                    }
                  },
                  {
                    "Name": "commit_sales",
                    "Description": "Validate source evidence and conditionally write synthetic CRM updates once per request.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "transcript": {
                          "Type": "string"
                        },
                        "opportunity_id": {
                          "Type": "string"
                        },
                        "request_id": {
                          "Type": "string"
                        },
                        "proposals": {
                          "Type": "array",
                          "Items": {
                            "Type": "object"
                          }
                        },
                        "authorization": {
                          "Type": "object",
                          "Properties": {
                            "grant": {
                              "Type": "object"
                            },
                            "signature": {
                              "Type": "string"
                            }
                          },
                          "Required": [
                            "grant",
                            "signature"
                          ]
                        }
                      },
                      "Required": [
                        "transcript",
                        "opportunity_id",
                        "request_id",
                        "proposals",
                        "authorization"
                      ]
                    }
                  },
                  {
                    "Name": "get_opportunity",
                    "Description": "Read validated events for one synthetic opportunity. No writes.",
                    "InputSchema": {
                      "Type": "object",
                      "Properties": {
                        "opportunity_id": {
                          "Type": "string"
                        },
                        "authorization": {
                          "Type": "object",
                          "Properties": {
                            "grant": {
                              "Type": "object"
                            },
                            "signature": {
                              "Type": "string"
                            }
                          },
                          "Required": [
                            "grant",
                            "signature"
                          ]
                        }
                      },
                      "Required": [
                        "opportunity_id",
                        "authorization"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    "IngressRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedDemo",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-ingress:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": {
                    "Ref": "SlackSecret"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "IngressFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-ingress"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "slack_handlers.webhook",
        "Role": {
          "Fn::GetAtt": [
            "IngressRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 15,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "SLACK_SECRET_ARN": {
              "Ref": "SlackSecret"
            },
            "QUEUE_URL": {
              "Ref": "Queue"
            }
          }
        }
      },
      "DependsOn": "IngressLogs"
    },
    "BackendRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedDemo",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-backend:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "BackendFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-backend"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "slack_handlers.backend",
        "Role": {
          "Fn::GetAtt": [
            "BackendRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 15,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "QUEUE_URL": {
              "Ref": "Queue"
            }
          }
        }
      },
      "DependsOn": "BackendLogs"
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "ScopedDemo",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogStream",
                    "logs:PutLogEvents"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/lambda/${AWS::StackName}-worker:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:ReceiveMessage",
                    "sqs:DeleteMessage",
                    "sqs:GetQueueAttributes"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "Queue",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::GetAtt": [
                      "JobsTable",
                      "Arn"
                    ]
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "secretsmanager:GetSecretValue"
                  ],
                  "Resource": [
                    {
                      "Ref": "SlackSecret"
                    },
                    {
                      "Ref": "AuthSecret"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:InvokeAgentRuntime",
                    "bedrock-agentcore:InvokeAgentRuntimeForUser"
                  ],
                  "Resource": [
                    {
                      "Ref": "RuntimeArn"
                    },
                    {
                      "Fn::Sub": "${RuntimeArn}/runtime-endpoint/demo"
                    }
                  ]
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:GetWorkloadAccessToken",
                    "bedrock-agentcore:GetWorkloadAccessTokenForUserId"
                  ],
                  "Resource": [
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:workload-identity-directory/default"
                    },
                    {
                      "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:workload-identity-directory/default/workload-identity/${RuntimeName}-*"
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "WorkerFunction": {
      "Type": "AWS::Lambda::Function",
      "Properties": {
        "FunctionName": {
          "Fn::Sub": "${AWS::StackName}-worker"
        },
        "Runtime": "python3.12",
        "Architectures": [
          "arm64"
        ],
        "Handler": "slack_handlers.worker",
        "Role": {
          "Fn::GetAtt": [
            "WorkerRole",
            "Arn"
          ]
        },
        "MemorySize": 256,
        "Timeout": 120,
        "Code": {
          "S3Bucket": {
            "Ref": "ArtifactBucket"
          },
          "S3Key": {
            "Ref": "CodeKey"
          }
        },
        "Environment": {
          "Variables": {
            "QUEUE_URL": {
              "Ref": "Queue"
            },
            "JOBS_TABLE": {
              "Ref": "JobsTable"
            },
            "RUNTIME_ARN": {
              "Ref": "RuntimeArn"
            },
            "SLACK_SECRET_ARN": {
              "Ref": "SlackSecret"
            },
            "AUTH_SECRET_ARN": {
              "Ref": "AuthSecret"
            }
          }
        },
        "ReservedConcurrentExecutions": 2
      },
      "DependsOn": "WorkerLogs"
    },
    "QueueMapping": {
      "Type": "AWS::Lambda::EventSourceMapping",
      "Properties": {
        "EventSourceArn": {
          "Fn::GetAtt": [
            "Queue",
            "Arn"
          ]
        },
        "FunctionName": {
          "Ref": "WorkerFunction"
        },
        "BatchSize": 1,
        "FunctionResponseTypes": [
          "ReportBatchItemFailures"
        ],
        "Enabled": true,
        "ScalingConfig": {
          "MaximumConcurrency": 2
        }
      }
    },
    "Api": {
      "Type": "AWS::ApiGatewayV2::Api",
      "Properties": {
        "Name": {
          "Fn::Sub": "${PipelineName}-slack"
        },
        "ProtocolType": "HTTP"
      }
    },
    "IngressIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "IngressFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 3000
      }
    },
    "BackendIntegration": {
      "Type": "AWS::ApiGatewayV2::Integration",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": [
            "BackendFunction",
            "Arn"
          ]
        },
        "PayloadFormatVersion": "2.0",
        "TimeoutInMillis": 3000
      }
    },
    "SlackRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "POST /slack/events",
        "AuthorizationType": "NONE",
        "Target": {
          "Fn::Sub": "integrations/${IngressIntegration}"
        }
      }
    },
    "BackendRoute": {
      "Type": "AWS::ApiGatewayV2::Route",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "RouteKey": "POST /jobs",
        "AuthorizationType": "AWS_IAM",
        "Target": {
          "Fn::Sub": "integrations/${BackendIntegration}"
        }
      }
    },
    "Stage": {
      "Type": "AWS::ApiGatewayV2::Stage",
      "Properties": {
        "ApiId": {
          "Ref": "Api"
        },
        "StageName": "$default",
        "AutoDeploy": true,
        "DefaultRouteSettings": {
          "ThrottlingRateLimit": 3,
          "ThrottlingBurstLimit": 5
        }
      }
    },
    "IngressPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "IngressFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/POST/slack/events"
        }
      }
    },
    "BackendPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": {
          "Ref": "BackendFunction"
        },
        "Action": "lambda:InvokeFunction",
        "Principal": "apigateway.amazonaws.com",
        "SourceAccount": {
          "Ref": "AWS::AccountId"
        },
        "SourceArn": {
          "Fn::Sub": "arn:${AWS::Partition}:execute-api:${AWS::Region}:${AWS::AccountId}:${Api}/*/POST/jobs"
        }
      }
    },
    "DeadLetterAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmDescription": "A GTM job exhausted retries; inspect failure logs and replay after repair",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [
          {
            "Name": "QueueName",
            "Value": {
              "Fn::GetAtt": [
                "DeadLetterQueue",
                "QueueName"
              ]
            }
          }
        ],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching"
      }
    }
  },
  "Outputs": {
    "GatewayUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Gateway",
          "GatewayUrl"
        ]
      }
    },
    "GatewayArn": {
      "Value": {
        "Fn::GetAtt": [
          "Gateway",
          "GatewayArn"
        ]
      }
    },
    "GatewayId": {
      "Value": {
        "Fn::GetAtt": [
          "Gateway",
          "GatewayIdentifier"
        ]
      }
    },
    "SlackUrl": {
      "Value": {
        "Fn::Sub": "${Api.ApiEndpoint}/slack/events"
      }
    },
    "ApiUrl": {
      "Value": {
        "Fn::GetAtt": [
          "Api",
          "ApiEndpoint"
