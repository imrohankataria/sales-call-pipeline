{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sales Call Pipeline app-gtm: dedicated single-Region deployment",
  "Parameters": {
    "ArtifactBucket": {
      "Type": "String"
    },
    "AgentCodeKey": {
      "Type": "String"
    },
    "GatewayUrl": {
      "Type": "String"
    },
    "GatewayArn": {
      "Type": "String"
    },
    "SkillCatalogKey": {
      "Type": "String"
    },
    "RuntimeName": {
      "Type": "String",
      "AllowedPattern": "[a-zA-Z][a-zA-Z0-9_]{2,47}"
    },
    "ModelId": {
      "Type": "String",
      "Default": "amazon.nova-lite-v1:0"
    }
  },
  "Resources": {
    "CrmTable": {
      "Type": "AWS::DynamoDB::Table",
      "Properties": {
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "opportunity_id",
            "AttributeType": "S"
          },
          {
            "AttributeName": "event_id",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "opportunity_id",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "event_id",
            "KeyType": "RANGE"
          }
        ],
        "TimeToLiveSpecification": {
          "AttributeName": "ttl",
          "Enabled": true
        },
        "SSESpecification": {
          "SSEEnabled": true
        }
      }
    },
    "AgentRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "bedrock-agentcore.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnLike": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock-agentcore:${AWS::Region}:${AWS::AccountId}:*"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "NovaAndBoundedApi",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock:InvokeModel"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:bedrock:${AWS::Region}::foundation-model/${ModelId}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/${AgentCodeKey}"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:CreateLogGroup",
                    "logs:CreateLogStream",
                    "logs:PutLogEvents",
                    "logs:DescribeLogStreams"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:log-group:/aws/bedrock-agentcore/runtimes/*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "logs:DescribeLogGroups"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:logs:${AWS::Region}:${AWS::AccountId}:*"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "cloudwatch:PutMetricData"
                  ],
                  "Resource": "*",
                  "Condition": {
                    "StringEquals": {
                      "cloudwatch:namespace": "bedrock-agentcore"
                    }
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "bedrock-agentcore:InvokeGateway"
                  ],
                  "Resource": {
                    "Ref": "GatewayArn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "s3:GetObject"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:s3:::${ArtifactBucket}/skills/*"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "Runtime": {
      "Type": "AWS::BedrockAgentCore::Runtime",
      "Properties": {
        "AgentRuntimeName": {
          "Ref": "RuntimeName"
        },
        "Description": "Sales call review and meeting preparation",
        "AgentRuntimeArtifact": {
          "CodeConfiguration": {
            "Code": {
              "S3": {
                "Bucket": {
                  "Ref": "ArtifactBucket"
                },
                "Prefix": {
                  "Ref": "AgentCodeKey"
                }
              }
            },
            "Runtime": "PYTHON_3_12",
            "EntryPoint": [
              "agent_app.py"
            ]
          }
        },
        "RoleArn": {
          "Fn::GetAtt": [
            "AgentRole",
            "Arn"
          ]
        },
        "NetworkConfiguration": {
          "NetworkMode": "PUBLIC"
        },
        "ProtocolConfiguration": "HTTP",
        "LifecycleConfiguration": {
          "IdleRuntimeSessionTimeout": 60,
          "MaxLifetime": 300
        },
        "EnvironmentVariables": {
          "GATEWAY_URL": {
            "Ref": "GatewayUrl"
          },
          "SKILL_BUCKET": {
            "Ref": "ArtifactBucket"
          },
          "SKILL_CATALOG_KEY": {
            "Ref": "SkillCatalogKey"
          },
          "AWS_REGION": {
            "Ref": "AWS::Region"
          },
          "AWS_ACCOUNT_ID": {
            "Ref": "AWS::AccountId"
          }
        },
        "Tags": {
          "Purpose": "SalesCallPipeline",
          "Data": "Synthetic"
        }
      }
    },
    "DemoEndpoint": {
      "Type": "AWS::BedrockAgentCore::RuntimeEndpoint",
      "Properties": {
        "AgentRuntimeId": {
          "Fn::GetAtt": [
            "Runtime",
            "AgentRuntimeId"
          ]
        },
        "AgentRuntimeVersion": {
          "Fn::GetAtt": [
            "Runtime",
            "AgentRuntimeVersion"
          ]
        },
        "Name": "demo",
        "Description": "Interview demonstration endpoint"
      }
    }
  },
  "Outputs": {
    "RuntimeArn": {
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeArn"
        ]
      }
    },
    "RuntimeId": {
      "Value": {
        "Fn::GetAtt": [
          "Runtime",
          "AgentRuntimeId"
        ]
      }
    },
    "EndpointId": {
      "Value": {
        "Fn::GetAtt": [
          "DemoEndpoint",
          "Id"
        ]
      }
    },
    "CrmTable": {
      "Value": {
        "Ref": "CrmTable"
      }
    }
  }
}
